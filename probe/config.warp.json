{
  "listen": "127.0.0.1:18082",
  "server_keys": ["test-key"],
  "zen_keys": [],
  "go_keys": [],
  "anonymous": true,
  "warp": { "enabled": true, "pool_size": 4, "stack": "ipv6", "source_ipv6": "" },
  "proxies": ["direct"],
  "proxyfile": "",
  "upstream": {
    "zen": "https://opencode.ai/zen",
    "go": "https://opencode.ai/zen/go",
    "anonymous": "https://opencode.ai/inference"
  },
  "retry": { "max_attempts": 3, "timeout_seconds": 120 },
  "models": { "refresh_seconds": 300, "protocols": {}, "free_only": true },
  "performance": {
    "max_idle_conns": 64,
    "max_idle_conns_per_host": 16,
    "max_conns_per_host": 0,
    "idle_conn_timeout_seconds": 60,
    "connect_timeout_seconds": 5,
    "failure_cooldown_seconds": 15,
    "attempt_timeout_seconds": 60,
    "first_event_timeout_seconds": 0,
    "max_anonymous_exits": 8,
    "free_tier_block_seconds": 900
  },
  "logging": { "level": "info", "ring_size": 500, "dump_request_bodies": false },
  "webui": { "enabled": false },
  "prefer": "go",
  "reasoning": { "effort": "high" },
  "rotation": {
    "sota": { "alias": "sota", "order": [] },
    "sweet": { "alias": "sweet", "order": [] },
    "first_output_seconds": 30
  }
}
